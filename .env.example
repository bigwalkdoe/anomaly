DATABASE_URL=postgresql+asyncpg://anomaly:anomaly@localhost:5432/anomaly
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=anomaly-evidence
RUNNER_IMAGE=anomaly-runner:dev
RUNNER_NETWORK=anomaly-net

# --- docker-compose.prod.yml (required: no insecure defaults) ---
# Set strong values via your environment/secret manager before `docker compose -f docker-compose.prod.yml ...`
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
# MINIO_ROOT_PASSWORD=
# JWT_SECRET=
# MINIO_ROOT_USER=minioadmin
# CORS_ORIGINS=https://your-web-origin.example
# NEXT_PUBLIC_API_URL=https://your-api-origin.example